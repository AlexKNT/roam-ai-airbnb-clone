# Copy to `.env.local` and fill in locally. Never commit real values.
# `EXPO_PUBLIC_*` values are bundled into the app: public identifiers only.
# Everything else is server-only and may only be used in API routes and local scripts.

# Clerk (auth)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# API routes (the policy chat calls one). Leave empty on web; on a device set the
# origin the dev server or hosted app is reachable at, e.g. https://your-app.example
EXPO_PUBLIC_API_ORIGIN=

# Sanity (properties, hosts, policies, house rules)
EXPO_PUBLIC_SANITY_PROJECT_ID=
EXPO_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# The private dataset that holds saved stays. Server-only: the app reaches it
# through /api/saved-stays. Create it in the Sanity dashboard with ACL set to private.
SANITY_PRIVATE_DATASET=
# Sanity CLI login (personal token, local scripts only)
SANITY_AUTH_TOKEN=

# TypeSafe AI (Jev: typed decisions in API routes only)
TYPESAFE_AI_API_KEY=

# PostHog (analytics)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
