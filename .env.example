# Copy to `.env.local` and fill in locally. Never commit real values.
# `EXPO_PUBLIC_*` values are bundled into the app: public identifiers only.
# Everything else is server-only and may only be used in API routes and local scripts.

# Clerk (auth)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sanity (properties, hosts, policies, house rules)
EXPO_PUBLIC_SANITY_PROJECT_ID=
EXPO_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# Sanity CLI login (personal token, local scripts only)
SANITY_AUTH_TOKEN=

# TypeSafe AI (Jev: typed decisions in API routes only)
TYPESAFE_AI_API_KEY=

# PostHog (analytics)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
